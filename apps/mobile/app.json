{
  "expo": {
    "name": "Acta 日历",
    "slug": "acta-calendar",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "android": {
      "package": "com.personal.actacalendar",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "WAKE_LOCK",
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ]
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#3B82F6"
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "ActaTodayTomorrowWidget",
              "label": "今日与明日日程",
              "description": "在桌面直接查看今天与明天的待办日程和订阅比赛时间",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ]
  }
}
